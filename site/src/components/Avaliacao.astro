---
// "Este artigo ajudou?" — envia para o ajuda-service (PUBLIC_AJUDA_API).
// Sem a API configurada o bloco não aparece.
interface Props { artigoId: string; produto: string }
const { artigoId, produto } = Astro.props;
const api = import.meta.env.PUBLIC_AJUDA_API as string | undefined;
---
{api && (
  <section class="avaliacao mt-10 bg-white border border-slate-200 rounded-lg p-5" data-api={api} data-artigo={artigoId} data-produto={produto}>
    <div class="etapa-voto flex flex-wrap items-center gap-3">
      <p class="text-sm font-medium text-slate-900 mr-2">Este artigo ajudou?</p>
      <button type="button" data-voto="1" class="border border-slate-300 text-slate-700 hover:bg-slate-50 text-sm font-medium px-4 py-2 rounded-md">Sim</button>
      <button type="button" data-voto="0" class="border border-slate-300 text-slate-700 hover:bg-slate-50 text-sm font-medium px-4 py-2 rounded-md">Não</button>
    </div>
    <form class="etapa-comentario hidden mt-4 space-y-3">
      <label class="block text-sm text-slate-700" for="aval-comentario">O que faltou ou está diferente na tela?</label>
      <textarea id="aval-comentario" name="comentario" rows="3" maxlength="1000" class="w-full border border-slate-300 rounded-md px-3 py-2 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-primary-600 focus:border-transparent"></textarea>
      <button class="bg-primary-600 hover:bg-primary-700 text-white text-sm font-medium px-4 py-2 rounded-md">Enviar</button>
    </form>
    <p class="etapa-fim hidden text-sm text-emerald-700">Obrigado! Sua resposta ajuda a melhorar a documentação.</p>
  </section>
)}

<script>
  for (const s of document.querySelectorAll<HTMLElement>('section.avaliacao')) {
    const { api, artigo, produto } = s.dataset;
    const enviar = (corpo: object) =>
      fetch(`${api}/avaliacoes`, { method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ artigo, produto, url: location.pathname, ...corpo }) }).catch(() => {});
    const mostrar = (cls: string) => s.querySelectorAll<HTMLElement>('[class*="etapa-"]').forEach(e => e.classList.toggle('hidden', !e.classList.contains(cls)));
    let voto = 0;
    s.querySelectorAll<HTMLButtonElement>('[data-voto]').forEach(b => b.addEventListener('click', () => {
      voto = Number(b.dataset.voto);
      if (voto) { enviar({ util: true }); mostrar('etapa-fim'); } else mostrar('etapa-comentario');
    }));
    s.querySelector('form')?.addEventListener('submit', e => {
      e.preventDefault();
      const comentario = (s.querySelector('textarea') as HTMLTextAreaElement).value.trim();
      enviar({ util: false, comentario }); mostrar('etapa-fim');
    });
  }
</script>
