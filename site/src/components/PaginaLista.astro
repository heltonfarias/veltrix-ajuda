---
import Base from '../layouts/Base.astro';
import Migalhas from './Migalhas.astro';
import CartaoArtigo from './CartaoArtigo.astro';
import { icone } from '../lib/icone';
import type { Artigo, ProdutoSite } from '../lib/dados';

interface Props {
  p: ProdutoSite;
  titulo: string;
  descricao: string;
  iconeNome: string;
  artigos: Artigo[];
  vazio: string;
  agruparPorModulo?: boolean;
}
const { p, titulo, descricao, iconeNome, artigos, vazio, agruparPorModulo = true } = Astro.props;
const grupos = agruparPorModulo
  ? p.modulos.map(m => [m.nome, artigos.filter(a => a.fm.modulo === m.slug)] as const).filter(([, l]) => l.length)
  : [['', artigos] as const];
---
<Base titulo={titulo} produto={p.slug} descricao={descricao}>
  <div class="max-w-5xl mx-auto px-4 py-8">
    <Migalhas itens={[{ rotulo: p.nome, href: `/${p.slug}/` }, { rotulo: titulo }]} />
    <header class="mt-6 flex items-start gap-4">
      <span class="size-12 shrink-0 rounded-lg bg-primary-50 text-primary-600 grid place-items-center" set:html={icone(iconeNome, 24)} />
      <div>
        <h1 class="text-3xl font-bold text-slate-900">{titulo}</h1>
        <p class="mt-2 text-slate-600">{descricao}</p>
      </div>
    </header>
    <slot />
    {artigos.length === 0
      ? <p class="mt-10 bg-white border border-slate-200 rounded-lg p-6 text-sm text-slate-600">{vazio}</p>
      : (
        <div class="mt-10 space-y-8">
          {grupos.map(([nome, lista]) => (
            <section>
              {nome && <h2 class="text-xs font-semibold text-slate-500 uppercase tracking-wider">{nome}</h2>}
              <div class="mt-3 grid gap-3 md:grid-cols-2">
                {lista.map(a => <CartaoArtigo artigo={a} produto={p.slug} />)}
              </div>
            </section>
          ))}
        </div>
      )}
  </div>
</Base>
