---
import Base from '../../../layouts/Base.astro';
import Migalhas from '../../../components/Migalhas.astro';
import CartaoArtigo from '../../../components/CartaoArtigo.astro';
import Avaliacao from '../../../components/Avaliacao.astro';
import {
  produtos, slugArtigo, rotuloTipo, nomePerfil, dataBR, urlVideo, urlTela, artigoPorId,
} from '../../../lib/dados';
import { renderizar } from '../../../lib/markdown';

export function getStaticPaths() {
  return produtos().flatMap(p =>
    p.artigos.map(a => ({
      params: { produto: p.slug, modulo: a.fm.modulo, artigo: slugArtigo(a) },
      props: { p, a, m: p.modulos.find(m => m.slug === a.fm.modulo)! },
    })),
  );
}
const { p, a, m } = Astro.props;
const fm = a.fm;
const { html, secoes } = renderizar(a.corpo, p.slug, a.arquivo.split('/').slice(0, -1).join('/'));
const telas = fm.features
  .map(id => p.manifesto?.funcionalidades.find(f => f.id === id))
  .filter((f): f is NonNullable<typeof f> => !!f);
const relacionados = fm.relacionados.map(id => artigoPorId(p, id)).filter(x => !!x);
const versao = p.manifesto?.versao;
---
<Base titulo={fm.titulo} produto={p.slug} descricao={fm.resumo}>
  <div class="max-w-7xl mx-auto px-4 py-8 lg:grid lg:grid-cols-[minmax(0,1fr)_16rem] lg:gap-12">
    <article data-pagefind-body>
      <span class="hidden" data-pagefind-filter="produto">{p.slug}</span>
      <span class="hidden" data-pagefind-filter="tipo">{rotuloTipo(fm.tipo)}</span>
      <span class="hidden" data-pagefind-meta="modulo">{m.nome}</span>

      <div data-pagefind-ignore>
        <Migalhas itens={[{ rotulo: p.nome, href: `/${p.slug}/` }, { rotulo: m.nome, href: `/${p.slug}/${m.slug}/` }, { rotulo: rotuloTipo(fm.tipo) }]} />
      </div>

      {fm.status !== 'publicado' && (
        <p class="mt-6 bg-amber-50 border border-amber-200 text-amber-800 text-sm rounded-md px-4 py-3" data-pagefind-ignore>
          <strong>Rascunho</strong> — este artigo ainda não foi revisado e aprovado.
        </p>
      )}

      <header class="mt-6">
        <h1 class="text-3xl font-bold text-slate-900" data-pagefind-meta="title">{fm.titulo}</h1>
        {fm.resumo && <p class="mt-3 text-lg text-slate-600">{fm.resumo}</p>}
        <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-slate-500" data-pagefind-ignore>
          {fm.revisado_em && <span>Atualizado em {dataBR(fm.revisado_em)}</span>}
          {fm.valido_desde && <span>Válido desde a versão {fm.valido_desde}</span>}
          {fm.perfis.map(pf => (
            <a href={`/${p.slug}/perfil/${pf}/`} class="inline-flex px-2 py-0.5 rounded-full font-medium bg-slate-100 text-slate-700 hover:bg-primary-50 hover:text-primary-700">{nomePerfil(pf)}</a>
          ))}
        </div>
      </header>

      {fm.videos.map(v => {
        const vid = urlVideo(v);
        return (
          <div class="mt-8 aspect-video rounded-lg overflow-hidden border border-slate-200 bg-slate-900" data-pagefind-ignore>
            <iframe class="size-full" src={vid.embed} title={`Vídeo: ${fm.titulo}`} loading="lazy"
              allow="accelerometer; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
          </div>
        );
      })}

      <div class="conteudo mt-8" set:html={html} />

      {telas.length > 0 && (
        <aside class="mt-10 bg-white border border-slate-200 rounded-lg p-5" data-pagefind-ignore>
          <h2 class="text-sm font-semibold text-slate-900">Onde fica no sistema</h2>
          <ul class="mt-3 space-y-2 text-sm">
            {telas.map(t => (
              <li class="flex flex-wrap items-baseline gap-x-2">
                <a href={urlTela(p.slug, t.id)} class="font-medium text-primary-600 hover:text-primary-700">{t.titulo}</a>
                {t.area && <span class="text-slate-500">{t.area}{t.submenu ? ` › ${t.submenu}` : ''}</span>}
              </li>
            ))}
          </ul>
        </aside>
      )}

      <div data-pagefind-ignore><Avaliacao artigoId={fm.id} produto={p.slug} /></div>

      {relacionados.length > 0 && (
        <section class="mt-10" data-pagefind-ignore>
          <h2 class="text-base font-semibold text-slate-900">Veja também</h2>
          <div class="mt-3 grid gap-3 md:grid-cols-2">
            {relacionados.map(r => <CartaoArtigo artigo={r!} produto={p.slug} compacto />)}
          </div>
        </section>
      )}
    </article>

    {secoes.length > 1 && (
      <aside class="hidden lg:block">
        <nav class="sticky top-24" aria-label="Nesta página">
          <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Nesta página</p>
          <ul class="mt-3 space-y-2 text-sm border-l border-slate-200">
            {secoes.map(s => <li><a href={`#${s.id}`} class="block -ml-px border-l border-transparent pl-3 text-slate-600 hover:text-slate-900 hover:border-slate-400">{s.titulo}</a></li>)}
          </ul>
          {versao && <p class="mt-6 text-xs text-slate-500">{p.nome} {versao}</p>}
        </nav>
      </aside>
    )}
  </div>
</Base>
