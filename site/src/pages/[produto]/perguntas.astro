---
import PaginaLista from '../../components/PaginaLista.astro';
import { produtos, produto } from '../../lib/dados';
export function getStaticPaths() { return produtos().map(p => ({ params: { produto: p.slug } })); }
const p = produto(Astro.params.produto!);
---
<PaginaLista p={p} titulo="Perguntas frequentes" iconeNome="circle-help"
  descricao="Respostas rápidas para as dúvidas mais comuns."
  artigos={p.artigos.filter(a => a.fm.tipo === 'faq')}
  vazio="Ainda não há perguntas frequentes publicadas." />
