---
// Ajuda de uma tela específica do sistema. É o destino do botão "?" dentro do ERP
// (Fase 4): /<produto>/tela/<featureId>/ — existe para TODAS as telas do manifesto,
// para que o link do sistema nunca caia num 404.
import Base from '../../../layouts/Base.astro';
import Migalhas from '../../../components/Migalhas.astro';
import CartaoArtigo from '../../../components/CartaoArtigo.astro';
import { produtos, urlModulo } from '../../../lib/dados';
import { icone } from '../../../lib/icone';

export function getStaticPaths() {
  return produtos().flatMap(p =>
    (p.manifesto?.funcionalidades ?? [])
      .filter(f => f.contexto === 'interno')
      .map(f => ({ params: { produto: p.slug, feature: f.id }, props: { p, f } })),
  );
}
const { p, f } = Astro.props;
const ordemTipo = ['procedimento', 'referencia', 'solucao', 'faq', 'conceito', 'aula', 'novidade'];
const artigos = p.artigos
  .filter(a => a.fm.features.some(id => id === f.id || f.id.startsWith(id + '.')))
  .sort((a, b) => ordemTipo.indexOf(a.fm.tipo) - ordemTipo.indexOf(b.fm.tipo));
const modulo = p.modulos.find(m => m.slug === f.modulo);
const suporte = import.meta.env.PUBLIC_SUPORTE_URL as string | undefined;
---
<Base titulo={`Ajuda: ${f.titulo}`} produto={p.slug} noindex={artigos.length === 0}>
  <div class="max-w-5xl mx-auto px-4 py-8">
    <Migalhas itens={[
      { rotulo: p.nome, href: `/${p.slug}/` },
      ...(modulo ? [{ rotulo: modulo.nome, href: urlModulo(p.slug, modulo.slug) }] : []),
      { rotulo: f.titulo },
    ]} />
    <header class="mt-6">
      <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">{f.area ?? 'Tela'}{f.submenu ? ` › ${f.submenu}` : ''}</p>
      <h1 class="mt-1 text-3xl font-bold text-slate-900">{f.titulo}</h1>
    </header>

    {artigos.length > 0 ? (
      <div class="mt-8 grid gap-3 md:grid-cols-2">
        {artigos.map(a => <CartaoArtigo artigo={a} produto={p.slug} />)}
      </div>
    ) : (
      <section class="mt-8 bg-white border border-slate-200 rounded-lg p-8 text-center">
        <span class="inline-block text-primary-600" set:html={icone('book-open', 32)} />
        <h2 class="mt-3 text-lg font-semibold text-slate-900">Ainda não há um guia para esta tela</h2>
        <p class="mt-2 text-sm text-slate-600">Ele está na fila de produção. Enquanto isso:</p>
        <div class="mt-5 flex flex-wrap justify-center gap-3">
          {modulo && <a href={urlModulo(p.slug, modulo.slug)} class="border border-slate-300 text-slate-700 hover:bg-slate-50 text-sm font-medium px-4 py-2 rounded-md">Ver o módulo {modulo.nome}</a>}
          <a href={`/${p.slug}/`} class="border border-slate-300 text-slate-700 hover:bg-slate-50 text-sm font-medium px-4 py-2 rounded-md">Buscar na ajuda</a>
          {suporte && <a href={suporte} class="bg-primary-600 hover:bg-primary-700 text-white text-sm font-medium px-4 py-2 rounded-md">Falar com o suporte</a>}
        </div>
      </section>
    )}
  </div>
</Base>
