---
import Base from '../layouts/Base.astro';
---
<Base titulo="Página não encontrada" noindex>
  <div class="max-w-xl mx-auto px-4 py-24 text-center">
    <p class="text-sm font-semibold text-primary-600">404</p>
    <h1 class="mt-2 text-3xl font-bold text-slate-900">Página não encontrada</h1>
    <p class="mt-3 text-slate-600">O endereço pode ter mudado. Comece pela página inicial e use a busca.</p>
    <a href="/" class="inline-block mt-8 bg-primary-600 hover:bg-primary-700 text-white text-sm font-medium px-4 py-2 rounded-md">Ir para a Central de Ajuda</a>
  </div>
</Base>
